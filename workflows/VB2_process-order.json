    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE orders SET error_text = $2 WHERE id = $1",
        "options": {
          "queryReplacement": "={{ [ $('Decide').first().json.id, ('submit: ' + JSON.stringify($json.error || $json)).slice(0, 1000) ] }}"
        }
      },
      "id": "1eb63a48-3d16-5ac1-9d3e-4bcf8327e52c",
      "name": "Save submit error",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1980,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "supabase-postgres",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH f AS (\n  UPDATE orders SET status = 'failed', error_text = $3, failed_at = now()\n  WHERE id = $1 AND status = 'generating' AND attempt = $2\n  RETURNING id, user_id, template_id, attempt\n)\nSELECT f.*, u.username FROM f JOIN users u ON u.telegram_id = f.user_id",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.attempt, $json.error ] }}"
        }
      },
      "id": "8cb76001-8cf4-551f-a171-9fb076551155",
      "name": "Mark failed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        480
      ],
      "credentials": {
        "postgres": {
          "id": "supabase-postgres",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const o = $('Decide').first().json;\nconst T = o.texts || {};\n\nconst t = (k, v = {}) => String(T[k] ?? k).replace(/\\{(\\w+)\\}/g, (m, x) => (v[x] ?? m));\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst r = $input.first().json;\nif (!r.id) return [];\nconst user = (r.username ? '@' + r.username + ' ' : '') + r.user_id;\nreturn [\n  { json: { method: 'sendMessage', payload: {\n    chat_id: r.user_id, text: t('err_generation'), parse_mode: 'HTML',\n    reply_markup: { inline_keyboard: [[{ text: t('btn_new'), callback_data: 'new' }]] },\n  } } },\n  { json: { method: 'sendMessage', payload: {\n    chat_id: $env.ADMIN_CHAT_ID, parse_mode: 'HTML',\n    text: t('admin_failed', { order_id: r.id, user: esc(user), template: esc(r.template_id), attempt: r.attempt, error: esc(String(o.error).slice(0, 500)) }),\n  } } },\n];\n"
      },
      "id": "df1bb517-0db6-5331-a312-46ec70024af7",
      "name": "Build fail messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/' + $json.method }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 100
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}"
      },
      "id": "47d9f112-c25c-5614-91d3-32bc69d17fcc",
      "name": "Send TG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        480
      ]
    }
