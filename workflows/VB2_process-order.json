    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE orders SET fal_request_id = $2, status_url = $3, response_url = $4\nWHERE id = $1 AND status = 'generating'",
        "options": {
          "queryReplacement": "={{ [ $('Decide').first().json.id, $json.request_id, $json.status_url, $json.response_url ] }}"
        }
      },
      "id": "fab96390-af22-529e-b2a2-e5d99bbddc99",
      "name": "Save request",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1980,
        120
      ],
      "credentials": {
        "postgres": {
          "id": "supabase-postgres",
          "name": "Supabase Postgres"
        }
