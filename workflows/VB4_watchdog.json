{
  "name": "VB4 watchdog",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "cd45edfc-d499-5872-9680-7517c31ad838",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (\n  SELECT coalesce((SELECT value FROM settings WHERE key = 'gen_timeout_min'), '5')::int AS tmo\n), x AS (\n  SELECT o.id AS order_id, o.fal_request_id, o.status_url, o.response_url, o.error_text,\n    CASE\n      WHEN o.fal_request_id IS NULL AND o.submitted_at IS NOT NULL\n           AND o.submitted_at < now() - interval '60 seconds' THEN 'resubmit'\n      WHEN o.fal_request_id IS NULL AND o.submitted_at IS NULL\n           AND o.gen_started_at < now() - interval '2 minutes' THEN 'stuck'\n      WHEN o.fal_request_id IS NOT NULL\n           AND o.submitted_at < now() - interval '60 seconds' THEN 'poll'\n    END AS kind,\n    coalesce(o.submitted_at < now() - make_interval(mins => s.tmo), false) AS timed_out\n  FROM orders o CROSS JOIN s\n  WHERE o.status = 'generating'\n)\nSELECT * FROM x WHERE kind IS NOT NULL",
        "options": {}
      },
      "id": "926d3229-2e53-52fe-afb2-a28c7d8a8570",
      "name": "Due orders",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "supabase-postgres",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "50847724-ab20-5037-9681-03648869264f",
                    "leftValue": "={{ $json.kind }}",
                    "rightValue": "resubmit",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "resubmit"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
