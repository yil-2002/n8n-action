      "id": "bfaf8a9b-26de-5c95-8b48-07198ab53ff7",
      "name": "fal result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((it, i) => {\n  const p = $('Poll decide').itemMatching(i).json;\n  const r = it.json;\n  const ok = r.statusCode === 200 && !!r.body?.video?.url;\n  return { json: {\n    request_id: p.request_id,\n    status: ok ? 'OK' : 'ERROR',\n    payload: r.body,\n    error: ok ? null : 'result HTTP ' + r.statusCode + ': ' + JSON.stringify(r.body).slice(0, 500),\n  } };\n});\n"
      },
