                  "version": 2
                },
                "conditions": [
                  {
                    "id": "400003df-6632-5cc2-abe3-fa0f90445b4f",
                    "leftValue": "={{ $json.kind }}",
                    "rightValue": "poll",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "poll"
            }
          ]
        },
        "options": {}
      },
      "id": "679b323b-6041-5b1f-a790-535f6709d2e4",
      "name": "Kind",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((i) => ({ json: {\n  order_id: i.json.order_id,\n  error: i.json.kind === 'stuck' ? 'stuck before submit' : (i.json.error_text || 'submit failed'),\n} }));\n"
      },
      "id": "be344efd-76b0-534a-aaf4-dc181c7697a3",
      "name": "Retry input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        160
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.status_url }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 20000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Key ' + $env.FAL_KEY }}"
            }
          ]
        }
      },
      "id": "7875a0ec-e347-5d03-a74b-290c547ac34f",
      "name": "fal status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const out = [];\n$input.all().forEach((it, i) => {\n  const row = $('Due orders').itemMatching(i).json;\n  const st = it.json.status;\n  if (st === 'COMPLETED') {\n    out.push({ json: { next: 'completed', order_id: row.order_id, request_id: row.fal_request_id, response_url: row.response_url } });\n  } else if (row.timed_out) {\n    out.push({ json: { next: 'timeout', order_id: row.order_id, error: 'timeout (' + (st || 'unknown') + ')' } });\n  }\n});\nreturn out;\n"
      },
      "id": "f226e69e-d48a-5700-ba4c-ae94bacc96ae",
