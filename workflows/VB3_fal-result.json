    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH d AS (\n  UPDATE orders\n  SET status = 'done', video_url = $2, api_cost_usd = api_cost_usd + $3, done_at = now()\n  WHERE fal_request_id = $1 AND status = 'generating'\n  RETURNING id, user_id, regen_used, video_url\n)\nSELECT d.*, (SELECT jsonb_object_agg(b.key, CASE WHEN u.lang = 'ru' AND coalesce(b.ru, '') <> '' THEN b.ru ELSE b.uz END) FROM bot_texts b) AS texts\nFROM d JOIN users u ON u.telegram_id = d.user_id",
        "options": {
          "queryReplacement": "={{ [ $json.request_id, $json.video_url, Number($env.FAL_COST_PER_VIDEO_USD || 0) ] }}"
        }
      },
      "id": "29ee6f05-a6ee-58e9-8638-05b34b17cb29",
      "name": "Claim done",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "supabase-postgres",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.id) return [];\nconst T = r.texts || {};\n\nconst t = (k, v = {}) => String(T[k] ?? k).replace(/\\{(\\w+)\\}/g, (m, x) => (v[x] ?? m));\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst rows = [];\nif (!r.regen_used) rows.push([{ text: t('btn_regen'), callback_data: 'regen:' + r.id }]);\nrows.push([{ text: t('btn_new'), callback_data: 'new' }]);\nreturn [{ json: {\n  order_id: r.id,\n  video_url: r.video_url,\n  method: 'sendVideo',\n  payload: { chat_id: r.user_id, video: r.video_url, caption: t('done'), parse_mode: 'HTML', supports_streaming: true, reply_markup: { inline_keyboard: rows } },\n} }];\n"
      },
