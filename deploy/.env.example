# Nusxa oling:  cp .env.example .env   — va qiymatlarni to'ldiring.
# Narx, timeout, kategoriyalar va h.k. -> Supabase'dagi `settings` jadvalida (restart shart emas).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...
ADMIN_CHAT_ID=123456789
# MVP: bot faqat admin va shu ro'yxatdagilarga javob beradi (vergul bilan)
ALLOWED_USER_IDS=
# true = hamma uchun ochiq (3-bosqichdan keyin)
BOT_PUBLIC=false

# --- fal.ai ---
FAL_KEY=
# Model bir qatorda almashtiriladi (keyin: docker compose up -d n8n):
FAL_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
# FAL_MODEL=fal-ai/minimax/hailuo-2.3/standard/image-to-video
FAL_COST_PER_VIDEO_USD=0.35
# Ixtiyoriy uzun tasodifiy satr:  openssl rand -hex 24
FAL_WEBHOOK_SECRET=

# --- n8n ---
# WEBHOOK_URL va N8N_EDITOR_BASE_URL ni deploy/tunnel.sh o'zi yozadi (Cloudflare quick tunnel).
WEBHOOK_URL=
N8N_EDITOR_BASE_URL=
# Code node'larida $env ishlashi uchun (n8n 2.x da default: true)
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE=Asia/Tashkent
TZ=Asia/Tashkent
# Bir marta yarating va o'zgartirmang (credential'lar shu bilan shifrlanadi):  openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Baza ---
# Supabase ulanishi n8n'ning o'zida "Postgres" credential sifatida kiritiladi (docs/02-setup.md).

# --- To'lov (3-bosqich) ---
# PAYMENT_PROVIDER_TOKEN=
# CLICK_SERVICE_ID= / CLICK_MERCHANT_ID= / CLICK_SECRET_KEY=
# PAYME_MERCHANT_ID= / PAYME_KEY=
