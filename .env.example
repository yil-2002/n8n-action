# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...
ADMIN_CHAT_ID=123456789
# /start dagi namuna video (botga bir marta yuborib, file_id ni oling)
SAMPLE_VIDEO_FILE_ID=

# --- fal.ai ---
FAL_KEY=
# Bir qatorda almashtiriladi:
FAL_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
# FAL_MODEL=fal-ai/minimax/hailuo-2.3/standard/image-to-video
FAL_COST_PER_VIDEO_USD=0.35
FAL_WEBHOOK_SECRET=uzun-tasodifiy-satr

# --- n8n ---
N8N_PUBLIC_URL=https://n8n.example.uz
# n8n Code node'larida $env ishlashi uchun:
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Biznes sozlamalari ---
PRICE_UZS=20000
MIN_IMAGE_SIDE=720
GEN_TIMEOUT_MIN=5
MAX_ATTEMPTS=2

# --- Baza (Postgres / Supabase) ---
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# --- To'lov (3-bosqich) ---
